# LiveKit Cloud project credentials. Copy to .env and fill values locally.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_USAGE_LOG=.runtime/livekit-usage.jsonl
LIVE_DIAGNOSTICS_LOG=.runtime/conversation-diagnostics.jsonl
# Contains local prompt and transcript text. Keep private and do not commit it.
LLM_CONTEXT_LOG=.runtime/llm-context.jsonl
# Release default. Uses LiveKit Inference and needs no separate model-provider key.
# Optional comparison adapters: gemini_live or openai_realtime. Install their
# matching Python extras before selecting one.
VOICE_PROVIDER=livekit_inference_pipeline
# Used only by the optional gemini_live adapter.
GOOGLE_API_KEY=
# Used only by the optional openai_realtime adapter.
OPENAI_API_KEY=
